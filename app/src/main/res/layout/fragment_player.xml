<androidx.percentlayout.widget.PercentFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="visible"
    tools:context=".fragment.PlayerFragment">

    <!-- 上半：封面 + 歌名歌手；下半：整屏居中的播放进度条 + 右侧时长 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        app:layout_heightPercent="56%"
        app:layout_widthPercent="92%">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:contentDescription="@string/todo"
                app:srcCompat="@drawable/ic_baseline_photo_size_select_actual_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:text="@string/msg_noMusic"
                    android:textColor="?attr/colorPrimaryVariant"
                    android:textSize="13sp"
                    tools:ignore="TextContrastCheck" />

                <!-- 歌手这一行：不播放时显示歌手，播放中换成单行歌词（高度固定一行，切换不跳版） -->
                <FrameLayout
                    android:id="@+id/fl_author"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_author"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/unknown"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        tools:ignore="SmallSp,TextContrastCheck" />

                    <cn.wearbbs.music.widget.SingleLineLrcView
                        android:id="@+id/lv_inline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="?attr/colorPrimaryVariant"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:ignore="SmallSp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 进度条铺满整个界面宽度并居中；右端跟着「当前 / 总时长」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pb_song"
                style="@style/SongProgressBar"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:text="@string/song_time_placeholder"
                android:textColor="#999999"
                android:textSize="9sp"
                tools:ignore="SmallSp,TextContrastCheck" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        app:layout_heightPercent="30%"
        app:layout_widthPercent="60%">

        <ImageView
            android:id="@+id/iv_precious"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/todo"
            android:rotationY="-180"
            android:scaleType="center"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_baseline_arrow_forward_ios_24" />

        <ImageView
            android:id="@+id/iv_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="3"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/todo"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_baseline_play_circle_filled_24" />

        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/todo"
            android:scaleType="center"
            android:src="@drawable/ic_baseline_arrow_forward_ios_24"
            android:theme="@style/RippleWhite" />

    </LinearLayout>

</androidx.percentlayout.widget.PercentFrameLayout>
